{
    "name": "deminy/couchbase-issues",
    "description": "To report/reproduce issues found in the Couchbase extension of PHP.",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": ">=7.4 <=8.1",
        "ext-couchbase": "~3.2.2"
    },
    "require-dev": {
        "couchbase/couchbase3": "3.2.2"
    },
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "couchbase/couchbase3",
                "version": "3.2.2",
                "dist": {
                    "url": "https://github.com/couchbase/php-couchbase/archive/v3.2.2.zip",
                    "type": "zip"
                }
            }
        }
    ],
    "config": {
        "platform": {
            "php": "8.1",
            "ext-couchbase": "3.2.2"
        },
        "discard-changes": true,
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "prefer-stable": true
}
